import bpy
import json
from mathutils import Vector

with open("08133_motion.json") as f:
    motion = json.load(f)

armature = bpy.data.objects["Armature"]

for frame_id, frame in enumerate(motion):

    bpy.context.scene.frame_set(frame_id + 1)

    # example landmarks
    shoulder = Vector(frame["pose"]["left_shoulder"])
    elbow = Vector(frame["pose"]["left_elbow"])
    wrist = Vector(frame["pose"]["left_wrist"])

    direction = elbow - shoulder

    bone = armature.pose.bones["LeftUpperArm"]

    # Point the bone toward elbow
    bone.rotation_mode = "QUATERNION"
    bone.rotation_quaternion = direction.to_track_quat("Y", "Z")

    bone.keyframe_insert(
        data_path="rotation_quaternion",
        frame=frame_id + 1
    )