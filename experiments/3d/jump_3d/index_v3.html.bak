<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- inline, so the browser stops asking the server for /favicon.ico -->
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ctext y='26' font-size='26'%3E%F0%9F%A4%9F%3C/text%3E%3C/svg%3E">
<title>Auslan 3D Motion Test</title>
<style>
    * { box-sizing: border-box; }

    body {
        margin: 0;
        background: #151515;
        color: #eee;
        font: 13px/1.5 ui-sans-serif, system-ui, Arial, sans-serif;
        overflow: hidden;
    }

    #panel {
        position: fixed;
        bottom: 16px;
        left: 16px;
        z-index: 10;
        background: rgba(0,0,0,0.66);
        backdrop-filter: blur(6px);
        padding: 14px 16px;
        border-radius: 10px;
        max-width: 290px;
    }

    button {
        padding: 8px 14px;
        margin: 0 6px 8px 0;
        cursor: pointer;
        font-size: 14px;
        border: 0;
        border-radius: 6px;
        background: #2f6fd0;
        color: white;
    }

    button.secondary { background: #3a3a3a; }
    button:hover { filter: brightness(1.15); }

    #status {
        margin-top: 6px;
        font-family: ui-monospace, monospace;
        font-size: 12px;
        color: #7ee8c8;
        white-space: pre-line;
    }

    .axes {
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid #333;
    }

    .axes label {
        display: block;
        margin: 5px 0;
        cursor: pointer;
        color: #bbb;
    }

    .hint {
        margin-top: 8px;
        font-size: 11px;
        color: #777;
    }

    #reference {
        position: fixed;
        right: 16px;
        bottom: 16px;
        width: 220px;
        z-index: 10;
        border-radius: 8px;
        border: 1px solid #333;
        background: #000;
    }

    #debug {
        position: fixed;
        top: 16px;
        right: 16px;
        z-index: 10;
        background: rgba(0,0,0,0.72);
        backdrop-filter: blur(6px);
        padding: 12px 14px;
        border-radius: 10px;
        font-family: ui-monospace, monospace;
        font-size: 11px;
        line-height: 1.45;
        color: #cfe8ff;
        white-space: pre;
        max-height: 70vh;
        overflow: auto;
    }
</style>
</head>
<body>

<div id="panel">
    <div>
        <button id="playButton">▶ Play sign</button>
        <button id="resetButton" class="secondary">Reset</button>
    </div>
    <label style="color:#bbb;cursor:pointer">
        <input type="checkbox" id="loopToggle" checked> loop
    </label>
    <div id="status">Loading…</div>

    <div class="axes">
        <label><input type="checkbox" id="mirrorX"> mirror left/right (X)</label>
        <label><input type="checkbox" id="flipZ"> flip depth (Z)</label>
        <label><input type="checkbox" id="faceAway"> turn Jake around</label>
        <label><input type="checkbox" id="debugToggle"> debug (key: d)</label>
        <div class="hint">
            If the motion is recognisable but pointing the wrong way, it is a
            coordinate-frame mismatch, not a retargeting failure. Toggle these.
        </div>
    </div>
</div>

<video id="reference" src="./jump.mp4" muted playsinline></video>
<div id="debug" hidden></div>

<script type="importmap">
{
    "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js",
        "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/"
    }
}
</script>

<script type="module">
import * as THREE from "three";
import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
import { OrbitControls } from "three/addons/controls/OrbitControls.js";

// ======================================================
// CALIBRATION
//
// Offsets are RADIANS, applied in the hand bone's own frame:
//   X pitch (flex/extend)  Y yaw (radial/ulnar)  Z roll (about forearm)
// Scales multiply measured angles: 1 = copy the signer.
// ======================================================
const CALIBRATION = {
    left: {
        WRIST_X_OFFSET: 0.0, WRIST_Y_OFFSET: 0.0, WRIST_Z_OFFSET: 0.0,
        FINGER_CURL_SCALE: 1.0, FINGER_SPREAD_SCALE: 1.0, FINGER_SPREAD_BIAS: 0.0,
        THUMB_CURL_SCALE: 1.0, THUMB_SPREAD_SCALE: 1.0
    },
    right: {
        WRIST_X_OFFSET: 0.0, WRIST_Y_OFFSET: 0.0, WRIST_Z_OFFSET: 0.0,
        FINGER_CURL_SCALE: 1.0, FINGER_SPREAD_SCALE: 1.0, FINGER_SPREAD_BIAS: 0.0,
        THUMB_CURL_SCALE: 1.0, THUMB_SPREAD_SCALE: 1.0
    }
};

// FINGER_SPREAD_BIAS is an offset, not a scale, because that is the fault
// it corrects: measured over this clip's open-hand frames the left hand
// fans correctly (index +4, mid -0, ring -3, pinky -9 degrees) while the
// right sits ~+15 degrees thumb-ward. Both default to 0 so nothing is
// silently tuned to one clip.

const FINGER_TRIM = { index: 1.0, mid: 1.0, ring: 1.0, pinky: 1.0 };

// Anatomical stops, radians.
const LIMITS = {
    mcpFlex: [-0.35, 1.75], pipFlex: [-0.10, 1.95], dipFlex: [-0.10, 1.45],
    mcpSpread: [-0.30, 0.30], thumbFlex: [-0.35, 1.40]
};

// Smoothing. Measured per-frame directional jitter: arm segments 1.4-4.9
// deg, right-hand proximal phalanges 3.1-4.1 (same order -- so they can
// be driven as hard as the arms), right ring/pinky middle phalanges
// 21-29 deg. Fingers carry the linguistic content, so they are NOT
// smoothed harder as a blanket rule; instead the noisy segments are
// identified per frame and only those are damped. See segmentConfidence.
const ARM_SMOOTHING = 0.45;
const HAND_SMOOTHING = 0.40;
const FINGER_SMOOTHING = 0.55;

// The PIP joint is a one-way hinge. A hand whose fingers ALL read as
// hyperextended is a bad fit, not a pose. Over this clip the right hand
// is consistent in 46/46 tracked frames (median PIP +39 deg); the resting
// left hand flips sign in 12, down to -98 deg.
const REJECT_PIP_BEND = -25 * Math.PI / 180;

// The PIP test alone is blind to one failure: when a detection is fitted
// inside out, the palm normal flips AND the curl axis flips with it, so
// the finger bends still measure self-consistently positive. It has to be
// caught on the palm frame itself, temporally. Measured over this clip:
//
//                          right hand     left hand
//   palm-normal sign flips     0             7      (max swing 84 deg/frame)
//   ill-conditioned axes       0             1
//   collapsed knuckle span     0             7
//
// A palm normal cannot reverse between two frames 33 ms apart, so a sign
// flip against the previous accepted frame is a mis-fit, not a motion.
// All three gates reject nothing at all on the right hand, which is the
// check that they target bad data rather than trimming good data.
const PALM_MIN_CONDITIONING = 0.35;   // |sin| between across and forward
const PALM_MIN_SPAN = 0.40;           // knuckle span / palm length

// Frames of ease in/out between Jake's neutral pose and the sign, so the
// clip neither starts nor ends mid-gesture.
const BLEND_FRAMES = 5;

// ======================================================
// SCENE
// ======================================================
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x202020);

const camera = new THREE.PerspectiveCamera(
    38, window.innerWidth / window.innerHeight, 0.01, 1000);
camera.position.set(0, 1.42, 2.05);

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
document.body.appendChild(renderer.domElement);

const controls = new OrbitControls(camera, renderer.domElement);
controls.target.set(0, 1.30, 0);
controls.enableDamping = true;

scene.add(new THREE.HemisphereLight(0xffffff, 0x444444, 2.2));
const keyLight = new THREE.DirectionalLight(0xffffff, 2.5);
keyLight.position.set(3, 5, 4);
scene.add(keyLight);
const fillLight = new THREE.DirectionalLight(0xffffff, 0.8);
fillLight.position.set(-3, 2, -2);
scene.add(fillLight);

const floor = new THREE.Mesh(
    new THREE.PlaneGeometry(20, 20),
    new THREE.MeshStandardMaterial({ color: 0x2c2c2c }));
floor.rotation.x = -Math.PI / 2;
scene.add(floor);

// ======================================================
// STATE
// ======================================================
let model = null;
let motion = null;
let fps = 30;
let aspect = 1;
let usingWorld = false;

let playing = false;
let startTime = 0;
let currentFrame = -1;

const statusElement = document.getElementById("status");
const referenceVideo = document.getElementById("reference");
const debugElement = document.getElementById("debug");

// ======================================================
// BONES
//
// CC_Base_L_Forearm's children are, in order, ElbowShareBone,
// ForearmTwist01, Hand -- "first child bone" would aim the forearm at a
// helper 53 degrees off. Every child is named explicitly.
// ======================================================
const ARMS = {
    left: {
        upper: "CC_Base_L_Upperarm", fore: "CC_Base_L_Forearm",
        hand: "CC_Base_L_Hand",
        shoulder: 11, elbow: 13, wrist: 15
    },
    right: {
        upper: "CC_Base_R_Upperarm", fore: "CC_Base_R_Forearm",
        hand: "CC_Base_R_Hand",
        shoulder: 12, elbow: 14, wrist: 16
    }
};

const FINGERS = ["index", "mid", "ring", "pinky"];
const FINGER_BONE = { index: "Index", mid: "Mid", ring: "Ring", pinky: "Pinky" };

const MP = { L_SHOULDER: 11, R_SHOULDER: 12, L_HIP: 23, R_HIP: 24 };

const HAND = {
    WRIST: 0, THUMB: [1, 2, 3, 4],
    index: [5, 6, 7, 8], mid: [9, 10, 11, 12],
    ring: [13, 14, 15, 16], pinky: [17, 18, 19, 20],
    INDEX_MCP: 5, MIDDLE_MCP: 9, PINKY_MCP: 17
};

const armRigs = {};
const handRigs = {};
const drivenBones = [];   // every bone we touch, with its rest quaternion

// ======================================================
// SOURCE SPACE -> SCENE SPACE
//
// MediaPipe: +x right across the image, +y DOWN, +z away from camera.
// Three.js: +x right, +y UP, +z towards the viewer. So y and z flip and
// x passes through. Verified against the data, not assumed: Jake's
// anatomical left is +X (his L_Upperarm sits at x=+0.152) and MediaPipe's
// LEFT_SHOULDER.x exceeds RIGHT_SHOULDER.x by +0.31 on average -- same
// sign, so no mirroring. The toggles below stay for clips shot mirrored
// or from behind; they are not part of the correct transform.
// ======================================================
const mirrorXInput = document.getElementById("mirrorX");
const flipZInput = document.getElementById("flipZ");

function mpVector(p, imageSpace, target) {
    const stretch = imageSpace ? aspect : 1;
    const v = target || new THREE.Vector3();
    v.set(p.x * stretch, -p.y, -p.z * stretch);
    if (mirrorXInput.checked) v.x = -v.x;
    if (flipZInput.checked) v.z = -v.z;
    return v;
}

function handednessParity() {
    let parity = 1;
    if (mirrorXInput.checked) parity = -parity;
    if (flipZInput.checked) parity = -parity;
    return parity;
}

// ======================================================
// BODY FRAME
//
// THE structural fix. Camera space is not body space: this signer is
// seated and turned, and the rotation carrying his body frame onto Jake's
// averages 13.9 degrees over the clip and peaks at 23.4. Feeding camera
// -space directions straight to the rig hands Jake the signer's torso
// lean as though it were arm motion.
//
// So every direction is expressed in the SIGNER's body frame and then
// re-expressed in JAKE's. Two consequences: the retargeting stops
// depending on where the camera was, and "turn Jake around" now rotates
// the motion with him instead of leaving it stuck to the world.
//
// Shoulder line and torso are NOT perpendicular on a real body -- their
// dot product averages 0.228 here -- so the basis is built by
// Gram-Schmidt with the torso as the primary axis, never assumed
// orthogonal.
// ======================================================
const _bx = new THREE.Vector3();
const _by = new THREE.Vector3();
const _bz = new THREE.Vector3();

function orthoBasis(acrossRaw, upRaw, outMatrix) {
    _by.copy(upRaw).normalize();
    _bx.copy(acrossRaw);
    _bx.addScaledVector(_by, -_bx.dot(_by)).normalize();
    _bz.crossVectors(_bx, _by);
    return outMatrix.makeBasis(_bx, _by, _bz);
}

const _sourceBasis = new THREE.Matrix4();
const _avatarBasis = new THREE.Matrix4();
const _sourceBodyQuat = new THREE.Quaternion();
const _avatarBodyQuat = new THREE.Quaternion();
const sourceToAvatar = new THREE.Quaternion();

const _p1 = new THREE.Vector3();
const _p2 = new THREE.Vector3();
const _p3 = new THREE.Vector3();
const _p4 = new THREE.Vector3();
const _across = new THREE.Vector3();
const _up = new THREE.Vector3();

let avatarAnchor = { chest: new THREE.Vector3(), shoulderWidth: 1 };
let avatarHip = null;
let avatarChest = null;

function updateBodyTransform(pose) {
    // ---- signer ----
    mpVector(pose[MP.L_SHOULDER], !usingWorld, _p1);
    mpVector(pose[MP.R_SHOULDER], !usingWorld, _p2);
    mpVector(pose[MP.L_HIP], !usingWorld, _p3);
    mpVector(pose[MP.R_HIP], !usingWorld, _p4);

    _across.subVectors(_p1, _p2);
    _up.addVectors(_p1, _p2).multiplyScalar(0.5)
       .sub(_p3.add(_p4).multiplyScalar(0.5));

    if (_across.lengthSq() < 1e-10 || _up.lengthSq() < 1e-10) return false;

    orthoBasis(_across, _up, _sourceBasis);
    _sourceBodyQuat.setFromRotationMatrix(_sourceBasis);

    // ---- Jake, in his CURRENT world orientation ----
    armRigs.left.upper.bone.getWorldPosition(_p1);
    armRigs.right.upper.bone.getWorldPosition(_p2);
    avatarHip.getWorldPosition(_p3);
    avatarChest.getWorldPosition(_p4);

    avatarAnchor.chest.copy(_p4);
    avatarAnchor.shoulderWidth = _p1.distanceTo(_p2);

    _across.subVectors(_p1, _p2);
    _up.subVectors(_p4, _p3);
    orthoBasis(_across, _up, _avatarBasis);
    _avatarBodyQuat.setFromRotationMatrix(_avatarBasis);

    sourceToAvatar.copy(_avatarBodyQuat)
        .multiply(_sourceBodyQuat.invert());

    return true;
}


// ======================================================
// ORIENT A BONE FROM A FULL BASIS
//
// Rest-relative throughout, as the Character Creator bones have their own
// local axes:
//
//   q_local = q_parent_world^-1 . q_target_world . q_restBasis^-1
//
// where q_restBasis is the bone's rest basis expressed in its own local
// space. Nothing is ever assigned a world rotation directly.
//
// Two axes, not one. setFromUnitVectors gives the SHORTEST arc, which
// leaves roll about the bone unconstrained and arbitrary -- that is what
// makes an arm look mechanical even when the joint positions are right.
// Supplying a reference axis pins the roll.
// ======================================================
const _targetBasis = new THREE.Matrix4();
const _targetQuat = new THREE.Quaternion();
const _restInverse = new THREE.Quaternion();
const _parentQuat = new THREE.Quaternion();

function restBasisQuaternion(primaryLocal, referenceLocal) {
    orthoBasis(referenceLocal, primaryLocal, _targetBasis);
    return new THREE.Quaternion().setFromRotationMatrix(_targetBasis);
}

function orientBone(entry, primaryWorld, referenceWorld, alpha) {
    const bone = entry.bone;

    if (primaryWorld.lengthSq() < 1e-10) return;

    orthoBasis(referenceWorld, primaryWorld, _targetBasis);
    _targetQuat.setFromRotationMatrix(_targetBasis);

    _restInverse.copy(entry.restBasis).invert();
    _targetQuat.multiply(_restInverse);

    bone.parent.getWorldQuaternion(_parentQuat).invert();
    _targetQuat.premultiply(_parentQuat);

    if (alpha >= 1) bone.quaternion.copy(_targetQuat);
    else bone.quaternion.slerp(_targetQuat, alpha);
}

// ======================================================
// ARM RIG CAPTURE
//
// The reference axis for the arms is the elbow hinge. It cannot be read
// off Jake's rest pose: his rest elbow bends only 1.02 degrees, so
// cross(upperArm, forearm) has magnitude 0.018 and its direction is
// numerically worthless. The MAGNITUDE is worthless; the SIGN is not. So
// the axis itself is taken from the hand's curl axis -- which is derived
// robustly, see captureHandRig -- and only its sign is voted for by that
// degenerate cross product. The two agree to |dot| = 0.83, which is the
// cross-check that this is the same anatomical axis.
//
// The source elbow is well conditioned everywhere: it bends 35-90 degrees
// across this clip and never drops below 10, so its plane is always
// defined.
// ======================================================
function captureArmRig(side) {
    const spec = ARMS[side];
    const upper = model.getObjectByName(spec.upper);
    const fore = model.getObjectByName(spec.fore);
    const hand = model.getObjectByName(spec.hand);

    if (!upper || !fore || !hand) {
        console.warn("MISSING arm bone for", side);
        return;
    }

    const wp = o => o.getWorldPosition(new THREE.Vector3());
    const shoulderPos = wp(upper), elbowPos = wp(fore), wristPos = wp(hand);

    const upperDir = elbowPos.clone().sub(shoulderPos).normalize();
    const foreDir = wristPos.clone().sub(elbowPos).normalize();

    const degenerate = new THREE.Vector3().crossVectors(upperDir, foreDir);

    armRigs[side] = {
        side, spec,
        upper: { bone: upper },
        fore: { bone: fore },
        restUpperDir: upperDir,
        restForeDir: foreDir,
        restCross: degenerate,     // sign only, magnitude ~0.018
        restElbowAxis: null        // filled once the hand rig exists
    };
}

function finishArmRig(side) {
    const arm = armRigs[side];
    const rig = handRigs[side];
    if (!arm || !rig) return;

    // hand curl axis in world at rest = the medio-lateral axis
    const axis = rig.curlLocal.clone()
        .applyQuaternion(rig.hand.getWorldQuaternion(new THREE.Quaternion()))
        .normalize();

    if (axis.dot(arm.restCross) < 0) axis.negate();
    arm.restElbowAxis = axis;

    arm.upper.restBasis = restBasisQuaternion(
        arm.restUpperDir.clone().applyQuaternion(
            arm.upper.bone.getWorldQuaternion(new THREE.Quaternion()).invert()),
        axis.clone().applyQuaternion(
            arm.upper.bone.getWorldQuaternion(new THREE.Quaternion()).invert())
    );

    arm.fore.restBasis = restBasisQuaternion(
        arm.restForeDir.clone().applyQuaternion(
            arm.fore.bone.getWorldQuaternion(new THREE.Quaternion()).invert()),
        axis.clone().applyQuaternion(
            arm.fore.bone.getWorldQuaternion(new THREE.Quaternion()).invert())
    );

    remember(arm.upper.bone);
    remember(arm.fore.bone);
}

function remember(bone) {
    drivenBones.push({ bone, rest: bone.quaternion.clone() });
}

// ======================================================
// HAND RIG CAPTURE
//
// The curl axis is DERIVED, not assumed. Character Creator ships hands
// with a few degrees of bend already in them and the axis of that bend IS
// the flexion axis. Measured across the four fingers against
// Index1->Pinky1 it comes out +1 on the left hand and -1 on the right --
// mirror images, as anatomy requires. That also fixes the palm normal via
// normal = curl x forward, confirmed by the thumb sitting on that side of
// the plane at rest.
// ======================================================
function captureHandRig(side) {
    const prefix = `CC_Base_${side === "left" ? "L" : "R"}_`;
    const hand = model.getObjectByName(`${prefix}Hand`);
    if (!hand) { console.warn("MISSING", `${prefix}Hand`); return; }

    const boneOf = n => model.getObjectByName(prefix + n);
    const worldOf = b => b.getWorldPosition(new THREE.Vector3());

    const mid1 = boneOf("Mid1"), index1 = boneOf("Index1"), pinky1 = boneOf("Pinky1");
    if (!mid1 || !index1 || !pinky1) { console.warn("MISSING finger roots"); return; }

    const forwardLocal = mid1.position.clone().normalize();
    const sideLocal = pinky1.position.clone().sub(index1.position).normalize();

    const handWorldQ = hand.getWorldQuaternion(new THREE.Quaternion());
    const sideWorld = sideLocal.clone().applyQuaternion(handWorldQ).normalize();

    let vote = 0;
    for (const finger of FINGERS) {
        const n = FINGER_BONE[finger];
        const a = boneOf(`${n}1`), b = boneOf(`${n}2`), c = boneOf(`${n}3`);
        if (!a || !b || !c) continue;
        const d1 = worldOf(b).sub(worldOf(a)).normalize();
        const d2 = worldOf(c).sub(worldOf(b)).normalize();
        vote += new THREE.Vector3().crossVectors(d1, d2).dot(sideWorld);
    }
    const curlSign = vote >= 0 ? 1 : -1;

    const curlLocal = sideLocal.clone().multiplyScalar(curlSign).normalize();
    const normalLocal = new THREE.Vector3()
        .crossVectors(curlLocal, forwardLocal).normalize();
    curlLocal.crossVectors(forwardLocal, normalLocal).normalize();

    const rig = {
        side, hand,
        restQuaternion: hand.quaternion.clone(),
        forwardLocal, curlLocal, normalLocal, curlSign,
        restBasis: restBasisQuaternion(forwardLocal, curlLocal),
        smoothed: hand.quaternion.clone(),
        lastNormal: new THREE.Vector3(0, 0, 1),
        lastAccepted: -99,
        knuckleSpan: worldOf(index1).distanceTo(worldOf(pinky1)),
        fingers: {}, thumb: null
    };
    remember(hand);

    // Flexion leaves its own axis invariant, so the curl axis expressed in
    // each successive bone's PARENT frame is the previous one pushed
    // through that bone's rest rotation. Walk the chain once.
    function chainAxes(boneNames) {
        const out = [];
        let curl = curlLocal.clone(), normal = normalLocal.clone();
        for (const name of boneNames) {
            const bone = boneOf(name);
            if (!bone) { out.push(null); continue; }
            out.push({ bone, rest: bone.quaternion.clone(),
                       curlAxis: curl.clone(), spreadAxis: normal.clone() });
            remember(bone);
            const inv = bone.quaternion.clone().invert();
            curl = curl.clone().applyQuaternion(inv).normalize();
            normal = normal.clone().applyQuaternion(inv).normalize();
        }
        return out;
    }

    const forwardWorld = forwardLocal.clone().applyQuaternion(handWorldQ).normalize();
    const curlWorld = curlLocal.clone().applyQuaternion(handWorldQ).normalize();
    const normalWorld = normalLocal.clone().applyQuaternion(handWorldQ).normalize();

    for (const finger of FINGERS) {
        const n = FINGER_BONE[finger];
        const joints = chainAxes([`${n}1`, `${n}2`, `${n}3`]);
        if (joints.some(j => !j)) continue;

        const a = worldOf(joints[0].bone), b = worldOf(joints[1].bone),
              c = worldOf(joints[2].bone);
        const d1 = b.clone().sub(a), d2 = c.clone().sub(b);
        const rest1 = swingAngles(d1, curlWorld, forwardWorld, normalWorld);

        rig.fingers[finger] = {
            joints,
            restMcpFlex: rest1.flex,
            restMcpSpread: rest1.spread,
            restPipFlex: hingeAngle(d1, d2, curlWorld),
            restDipFlex: 0   // Index3 etc. are leaves; the rig states no distal bend
        };
    }

    const thumbJoints = chainAxes(["Thumb1", "Thumb2", "Thumb3"]);
    if (!thumbJoints.some(j => !j)) {
        const a = worldOf(thumbJoints[0].bone), b = worldOf(thumbJoints[1].bone),
              c = worldOf(thumbJoints[2].bone);
        const d0 = b.clone().sub(a).normalize();
        rig.thumb = {
            joints: thumbJoints,
            restDirLocal: new THREE.Vector3(
                d0.dot(curlWorld), d0.dot(forwardWorld), d0.dot(normalWorld)),
            restMcpFlex: hingeAngle(b.clone().sub(a), c.clone().sub(b), curlWorld),
            restIpFlex: 0
        };
    }

    handRigs[side] = rig;
}

// ======================================================
// JOINT ANGLE MEASUREMENT
//
// All 15 finger segment directions are used -- MCP->PIP, PIP->DIP,
// DIP->TIP for each of five digits -- but each is retargeted THROUGH THE
// JOINT'S ACTUAL DEGREES OF FREEDOM rather than aimed blindly. That is
// what rejects the noise: measured per-frame directional jitter is 3-4
// degrees on the right hand's proximal phalanges (as clean as the arm
// segments) but 21-29 degrees on its ring and pinky middle phalanges.
// Most of that jitter lives in axes a hinge cannot move along, so
// constraining the joint discards it instead of rendering it.
//
//   MCP     ball joint  -> swingAngles: flexion + spread from seg1
//   PIP/DIP one-way hinge -> hingeAngle between consecutive segments
//   Thumb1  saddle joint -> aimed directly through the palm basis
// ======================================================
const _sw = { flex: 0, spread: 0, planar: 0 };
const _d = new THREE.Vector3();
const _h1 = new THREE.Vector3();
const _h2 = new THREE.Vector3();
const _hcross = new THREE.Vector3();

function swingAngles(direction, curl, forward, normal) {
    _d.copy(direction);
    if (_d.lengthSq() < 1e-12) { _sw.flex = 0; _sw.spread = 0; _sw.planar = 1; return _sw; }
    _d.normalize();
    const c = _d.dot(curl), f = _d.dot(forward), n = _d.dot(normal);
    _sw.planar = Math.hypot(c, f);
    _sw.flex = Math.atan2(n, _sw.planar);
    _sw.spread = Math.atan2(-c, f);
    return _sw;
}

// Spread is only meaningful on a reasonably open hand: as a finger folds
// into the palm the in-plane component it is measured from shrinks to
// nothing. Measured naively a closing fist read as all four fingers
// fanned 100 degrees sideways.
function spreadConfidence(planar) {
    const t = Math.min(1, Math.max(0, (planar - 0.45) / 0.35));
    return t * t * (3 - 2 * t);
}

function hingeAngle(v1, v2, axis) {
    _h1.copy(v1); _h2.copy(v2);
    if (_h1.lengthSq() < 1e-12 || _h2.lengthSq() < 1e-12) return 0;
    _h1.normalize(); _h2.normalize();
    _hcross.crossVectors(_h1, _h2);
    const angle = Math.acos(Math.min(1, Math.max(-1, _h1.dot(_h2))));
    return _hcross.dot(axis) >= 0 ? angle : -angle;
}

function clamp(value, range) {
    return Math.min(range[1], Math.max(range[0], value));
}

// ======================================================
// PER-SEGMENT CONFIDENCE
//
// A phalanx has a fixed length. When the reconstructed length departs
// from that finger's median for the clip, the landmark is misplaced and
// its direction should not be trusted -- so that joint is damped rather
// than driven. This is what keeps the ring and pinky from thrashing
// without having to smooth the whole hand into mush and lose the
// linguistic content of the finger transitions.
// ======================================================
const segmentMedians = {};   // segmentMedians[handKey][finger][segIndex]

function prepareSegmentStatistics(frames) {
    for (const [handKey, _] of [["left_hand"], ["right_hand"]]) {
        segmentMedians[handKey] = {};
        for (const finger of [...FINGERS, "thumb"]) {
            const indices = finger === "thumb" ? HAND.THUMB : HAND[finger];
            segmentMedians[handKey][finger] = [];

            for (let seg = 0; seg < 3; seg++) {
                const samples = [];
                for (const frame of frames) {
                    const lm = frame[handKey];
                    if (!lm || lm.length !== 21) continue;
                    const scale = Math.hypot(
                        lm[HAND.INDEX_MCP].x - lm[HAND.PINKY_MCP].x,
                        lm[HAND.INDEX_MCP].y - lm[HAND.PINKY_MCP].y);
                    if (scale < 1e-6) continue;
                    const a = lm[indices[seg]], b = lm[indices[seg + 1]];
                    samples.push(Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z) / scale);
                }
                samples.sort((p, q) => p - q);
                segmentMedians[handKey][finger].push(
                    samples.length ? samples[samples.length >> 1] : 0);
            }
        }
    }
}

function segmentConfidence(handKey, finger, seg, observed, scale) {
    const median = segmentMedians[handKey]?.[finger]?.[seg];
    if (!median || scale < 1e-9) return 1;
    const ratio = (observed / scale) / median;
    if (ratio <= 0) return 0.2;
    // exp decay in log-length, so half and double are penalised equally
    return Math.max(0.2, Math.exp(-2.5 * Math.abs(Math.log(ratio))));
}

// ======================================================
// PALM FRAME FROM MEDIAPIPE
//
// The wrist is NOT solved from elbow->wrist. A single direction cannot
// say whether the palm faces up or down, and palm orientation is
// phonemic in Auslan. The palm is a plane, so three points on it define
// the orientation that one direction cannot.
// ======================================================
const _lm = [];
for (let i = 0; i < 21; i++) _lm.push(new THREE.Vector3());

function palmFrame(landmarks, curlSign) {
    for (let i = 0; i < 21; i++) {
        mpVector(landmarks[i], true, _lm[i]);
        _lm[i].applyQuaternion(sourceToAvatar);
    }

    const wrist = _lm[HAND.WRIST];
    const indexMcp = _lm[HAND.INDEX_MCP];
    const middleMcp = _lm[HAND.MIDDLE_MCP];
    const pinkyMcp = _lm[HAND.PINKY_MCP];

    const forward = new THREE.Vector3()
        .addVectors(indexMcp, pinkyMcp)
        .addScaledVector(middleMcp, 2)
        .multiplyScalar(0.25)
        .sub(wrist);
    const across = new THREE.Vector3().subVectors(pinkyMcp, indexMcp);

    const palmLength = forward.length();
    const spanLength = across.length();
    if (palmLength < 1e-9 || spanLength < 1e-9) return null;

    forward.normalize();
    across.normalize();

    // How far from parallel the two palm axes are. When they collapse
    // towards each other the normal is the cross product of two nearly
    // identical vectors, i.e. noise, and the whole hand orientation
    // becomes meaningless.
    const conditioning = new THREE.Vector3()
        .crossVectors(across, forward).length();

    const curl = across.clone().multiplyScalar(curlSign * handednessParity());
    const normal = new THREE.Vector3().crossVectors(curl, forward);
    if (normal.lengthSq() < 1e-10) return null;
    normal.normalize();
    curl.crossVectors(forward, normal).normalize();

    return {
        wrist: wrist.clone(), forward, curl, normal,
        conditioning, spanRatio: spanLength / palmLength
    };
}

// ======================================================
// WRIST
// ======================================================
const _offsetEuler = new THREE.Euler();
const _offsetQuat = new THREE.Quaternion();

function applyPalm(rig, frame, alpha) {
    const cal = CALIBRATION[rig.side];
    orientBone({ bone: rig.hand, restBasis: rig.restBasis },
               frame.forward, frame.curl, 1);

    _offsetEuler.set(cal.WRIST_X_OFFSET, cal.WRIST_Y_OFFSET, cal.WRIST_Z_OFFSET, "XYZ");
    _offsetQuat.setFromEuler(_offsetEuler);
    rig.hand.quaternion.multiply(_offsetQuat);

    if (alpha < 1) {
        rig.hand.quaternion.copy(
            rig.smoothed.slerp(rig.hand.quaternion, alpha));
    }
    rig.smoothed.copy(rig.hand.quaternion);
}

// ======================================================
// FINGERS
// ======================================================
const _jointQuat = new THREE.Quaternion();
const _spreadQuat = new THREE.Quaternion();
const _v1 = new THREE.Vector3();
const _v2 = new THREE.Vector3();
const _v3 = new THREE.Vector3();
const _aimParent = new THREE.Quaternion();
const _aimQuat = new THREE.Quaternion();
const _aimTarget = new THREE.Vector3();
const _aimRestDir = new THREE.Vector3();

function setJoint(joint, flex, spread, alpha) {
    _jointQuat.setFromAxisAngle(joint.curlAxis, flex);
    if (spread) {
        _spreadQuat.setFromAxisAngle(joint.spreadAxis, spread);
        _jointQuat.premultiply(_spreadQuat);
    }
    _jointQuat.multiply(joint.rest);
    if (alpha >= 1) joint.bone.quaternion.copy(_jointQuat);
    else joint.bone.quaternion.slerp(_jointQuat, alpha);
}

function aimJoint(joint, targetWorld, alpha) {
    const bone = joint.bone;
    const child = bone.children.find(c => c.isBone);
    if (!child) return;
    bone.parent.getWorldQuaternion(_aimParent).invert();
    _aimTarget.copy(targetWorld).applyQuaternion(_aimParent).normalize();
    _aimRestDir.copy(child.position).normalize()
        .applyQuaternion(joint.rest).normalize();
    _aimQuat.setFromUnitVectors(_aimRestDir, _aimTarget).multiply(joint.rest);
    if (alpha >= 1) bone.quaternion.copy(_aimQuat);
    else bone.quaternion.slerp(_aimQuat, alpha);
}

// Confidence damps SMOOTHING; it must not apply to an instantaneous
// pose. Multiplying it into a snap turns the snap into a partial slerp
// whose residual depends on whatever the bone was doing before, which
// made an identical frame resolve differently depending on history.
function blendAlpha(base, confidence) {
    return base >= 1 ? 1 : base * confidence;
}

function applyFingers(rig, frame, handKey, baseAlpha, readout) {
    const cal = CALIBRATION[rig.side];
    const { forward, curl, normal } = frame;
    const scale = _lm[HAND.INDEX_MCP].distanceTo(_lm[HAND.PINKY_MCP]);

    for (const finger of FINGERS) {
        const data = rig.fingers[finger];
        if (!data) continue;

        const [mcp, pip, dip, tip] = HAND[finger].map(i => _lm[i]);
        const curlScale = cal.FINGER_CURL_SCALE * (FINGER_TRIM[finger] || 1);

        _v1.subVectors(pip, mcp);
        _v2.subVectors(dip, pip);
        _v3.subVectors(tip, dip);

        const c1 = segmentConfidence(handKey, finger, 0, _v1.length(), scale);
        const c2 = segmentConfidence(handKey, finger, 1, _v2.length(), scale);
        const c3 = segmentConfidence(handKey, finger, 2, _v3.length(), scale);

        const swing = swingAngles(_v1, curl, forward, normal);

        const mcpFlex = clamp((swing.flex - data.restMcpFlex) * curlScale, LIMITS.mcpFlex);
        const mcpSpread = clamp(
            (swing.spread - data.restMcpSpread - cal.FINGER_SPREAD_BIAS)
            * spreadConfidence(swing.planar) * cal.FINGER_SPREAD_SCALE,
            LIMITS.mcpSpread);
        const pipFlex = clamp(
            (hingeAngle(_v1, _v2, curl) - data.restPipFlex) * curlScale, LIMITS.pipFlex);
        const dipFlex = clamp(
            (hingeAngle(_v2, _v3, curl) - data.restDipFlex) * curlScale, LIMITS.dipFlex);

        setJoint(data.joints[0], mcpFlex, mcpSpread, blendAlpha(baseAlpha, c1));
        setJoint(data.joints[1], pipFlex, 0, blendAlpha(baseAlpha, Math.min(c1, c2)));
        setJoint(data.joints[2], dipFlex, 0, blendAlpha(baseAlpha, Math.min(c2, c3)));

        if (readout) readout[finger] = [mcpFlex, pipFlex, dipFlex, mcpSpread, c1, c2, c3];
    }

    // ---- thumb, handled separately: its saddle joint swings on two axes
    // at once, so Thumb1 is aimed rather than hinged. Its segments are
    // also the cleanest on the hand (4.0-6.9 deg jitter), so it can be
    // driven hard.
    const thumb = rig.thumb;
    if (!thumb) return;

    const [cmc, mcpT, ip, tipT] = HAND.THUMB.map(i => _lm[i]);

    _v1.subVectors(mcpT, cmc);
    const t1 = segmentConfidence(handKey, "thumb", 0, _v1.length(), scale);
    if (_v1.lengthSq() > 1e-10) {
        _v1.normalize();
        const rest = thumb.restDirLocal;
        const aCurl = rest.x + (_v1.dot(curl) - rest.x) * cal.THUMB_SPREAD_SCALE;
        const aFwd = _v1.dot(forward);
        const aNorm = rest.z + (_v1.dot(normal) - rest.z) * cal.THUMB_CURL_SCALE;
        _v2.copy(curl).multiplyScalar(aCurl)
            .addScaledVector(forward, aFwd).addScaledVector(normal, aNorm);
        if (_v2.lengthSq() > 1e-10)
            aimJoint(thumb.joints[0], _v2.normalize(), blendAlpha(baseAlpha, t1));
    }

    _v1.subVectors(mcpT, cmc);
    _v2.subVectors(ip, mcpT);
    _v3.subVectors(tipT, ip);
    const t2 = segmentConfidence(handKey, "thumb", 1, _v2.length(), scale);
    const t3 = segmentConfidence(handKey, "thumb", 2, _v3.length(), scale);

    const thumbMcp = clamp(
        (hingeAngle(_v1, _v2, curl) - thumb.restMcpFlex) * cal.THUMB_CURL_SCALE,
        LIMITS.thumbFlex);
    const thumbIp = clamp(
        (hingeAngle(_v2, _v3, curl) - thumb.restIpFlex) * cal.THUMB_CURL_SCALE,
        LIMITS.thumbFlex);

    setJoint(thumb.joints[1], thumbMcp, 0, blendAlpha(baseAlpha, Math.min(t1, t2)));
    setJoint(thumb.joints[2], thumbIp, 0, blendAlpha(baseAlpha, Math.min(t2, t3)));

    if (readout) readout.thumb = [thumbMcp, thumbIp, t1];
}

// ======================================================
// PLAUSIBILITY
//
// PIP is a one-way hinge. One finger reading backwards is noise; all four
// means the detection has the hand inside out.
// ======================================================
const _pipBends = [];

function medianPipBend(rig, frame) {
    _pipBends.length = 0;
    for (const finger of FINGERS) {
        if (!rig.fingers[finger]) continue;
        const [mcp, pip, dip] = HAND[finger].map(i => _lm[i]);
        _v1.subVectors(pip, mcp);
        _v2.subVectors(dip, pip);
        _pipBends.push(hingeAngle(_v1, _v2, frame.curl));
    }
    if (!_pipBends.length) return 0;
    _pipBends.sort((a, b) => a - b);
    const m = _pipBends.length >> 1;
    return _pipBends.length % 2 ? _pipBends[m] : (_pipBends[m - 1] + _pipBends[m]) / 2;
}

function rejectReason(rig, basis, index) {
    if (basis.conditioning < PALM_MIN_CONDITIONING) return "flat palm";
    if (basis.spanRatio < PALM_MIN_SPAN) return "hand collapsed";
    if (rig.lastAccepted === index - 1 && basis.normal.dot(rig.lastNormal) < 0)
        return "palm flipped";
    if (medianPipBend(rig, basis) < REJECT_PIP_BEND) return "fingers inside out";
    return null;
}

function relaxHand(rig, alpha) {
    rig.hand.quaternion.slerp(rig.restQuaternion, alpha);
    rig.smoothed.copy(rig.hand.quaternion);
    for (const finger of FINGERS) {
        const data = rig.fingers[finger];
        if (!data) continue;
        for (const j of data.joints) j.bone.quaternion.slerp(j.rest, alpha);
    }
    if (rig.thumb) for (const j of rig.thumb.joints) j.bone.quaternion.slerp(j.rest, alpha);
}

// ======================================================
// APPLY ONE FRAME
// ======================================================
const debugState = { frame: 0, hands: {}, arms: {}, bodyAngle: 0 };

const _shoulder = new THREE.Vector3();
const _elbow = new THREE.Vector3();
const _wristPt = new THREE.Vector3();
const _upperDir = new THREE.Vector3();
const _foreDir = new THREE.Vector3();
const _elbowPlane = new THREE.Vector3();
const _tmpDir = new THREE.Vector3();
const _lastPlane = { left: new THREE.Vector3(0, 0, 1), right: new THREE.Vector3(0, 0, 1) };

function applyFrame(frame, index, snap) {
    if (!frame || !model) return;

    const pose = usingWorld ? frame.pose_world : frame.pose;
    if (!pose || pose.length < 25) return;

    model.updateMatrixWorld(true);
    if (!updateBodyTransform(pose)) return;

    debugState.frame = index;
    debugState.bodyAngle = 2 * Math.acos(
        Math.min(1, Math.abs(sourceToAvatar.w))) * 180 / Math.PI;

    const armAlpha = snap ? 1 : ARM_SMOOTHING;
    const handAlpha = snap ? 1 : HAND_SMOOTHING;
    const fingerAlpha = snap ? 1 : FINGER_SMOOTHING;

    // ---- arms -------------------------------------------------------
    // Both the elbow AND the wrist are followed: the upper arm is aimed
    // at shoulder->elbow (so the elbow tracks the source elbow, it is not
    // inferred from the wrist) and the forearm at elbow->wrist. The
    // elbow-plane normal is fed to both as the roll reference, which is
    // what stops the shortest-arc solution from twisting the limb into a
    // mechanical-looking pose while the joint positions stay correct.
    for (const side of ["left", "right"]) {
        const arm = armRigs[side];
        if (!arm) continue;
        const spec = arm.spec;

        mpVector(pose[spec.shoulder], !usingWorld, _shoulder).applyQuaternion(sourceToAvatar);
        mpVector(pose[spec.elbow], !usingWorld, _elbow).applyQuaternion(sourceToAvatar);
        mpVector(pose[spec.wrist], !usingWorld, _wristPt).applyQuaternion(sourceToAvatar);

        _upperDir.subVectors(_elbow, _shoulder);
        _foreDir.subVectors(_wristPt, _elbow);
        _elbowPlane.crossVectors(_upperDir, _foreDir);

        // A straight arm has no plane. Never happens in this clip (the
        // elbow bends 35-90 degrees) but a held reference is the correct
        // fallback rather than an arbitrary axis.
        if (_elbowPlane.lengthSq() < 1e-8) _elbowPlane.copy(_lastPlane[side]);
        else _lastPlane[side].copy(_elbowPlane).normalize();

        orientBone(arm.upper, _upperDir, _elbowPlane, armAlpha);
        model.updateMatrixWorld(true);
        orientBone(arm.fore, _foreDir, _elbowPlane, armAlpha);
        model.updateMatrixWorld(true);

        // Source -> bone check, taken here and not in the debug pass:
        // afterwards blendToNeutral deliberately pulls the arms towards
        // rest at the clip's ends, and measuring past that would report
        // the easing as retargeting error.
        const rig = handRigs[side];
        arm.upper.bone.getWorldPosition(_boneA);
        arm.fore.bone.getWorldPosition(_boneB);
        const upperLength = _boneA.distanceTo(_boneB);
        const wristNow = rig ? rig.hand.getWorldPosition(new THREE.Vector3()) : _boneB;
        const foreLength = _boneB.distanceTo(wristNow);

        const srcShoulder = _boneA.clone();
        const srcElbow = srcShoulder.clone().addScaledVector(
            _tmpDir.copy(_upperDir).normalize(), upperLength);
        const srcWrist = srcElbow.clone().addScaledVector(
            _tmpDir.copy(_foreDir).normalize(), foreLength);

        debugState.arms[side] = {
            shoulder: _shoulder.clone(), elbow: _elbow.clone(), wrist: _wristPt.clone(),
            bend: _upperDir.angleTo(_foreDir) * 180 / Math.PI,
            srcShoulder, srcElbow, srcWrist,
            elbowError: _boneB.distanceTo(srcElbow),
            wristError: wristNow.distanceTo(srcWrist)
        };
    }

    // ---- hands ------------------------------------------------------
    for (const side of ["left", "right"]) {
        const rig = handRigs[side];
        if (!rig) continue;
        const handKey = side === "left" ? "left_hand" : "right_hand";
        const landmarks = frame[handKey];

        if (!landmarks || landmarks.length !== 21) {
            relaxHand(rig, snap ? 1 : fingerAlpha);
            debugState.hands[side] = null;
            continue;
        }

        const basis = palmFrame(landmarks, rig.curlSign);
        if (!basis) {
            relaxHand(rig, snap ? 1 : fingerAlpha);
            debugState.hands[side] = null;
            continue;
        }

        const reason = rejectReason(rig, basis, index);
        if (reason) {
            const previous = debugState.hands[side];
            debugState.hands[side] = previous
                ? { ...previous, rejected: reason }
                : { rejected: reason, basis, fingers: {} };
            continue;
        }

        rig.lastNormal.copy(basis.normal);
        rig.lastAccepted = index;

        applyPalm(rig, basis, handAlpha);
        model.updateMatrixWorld(true);

        const readout = {};
        applyFingers(rig, basis, handKey, fingerAlpha, readout);

        debugState.hands[side] = {
            basis, fingers: readout, rejected: false,
            landmarks: _lm.map(v => v.clone()),
            quaternion: rig.hand.quaternion.clone()
        };
    }

    // ---- ease in and out of Jake's neutral pose ---------------------
    blendToNeutral(neutralWeight(index));

    model.updateMatrixWorld(true);
    if (debugOn) updateDebug();
}

// ======================================================
// NEUTRAL BLENDING
//
// So the clip neither starts nor ends mid-gesture with the arms parked
// somewhere arbitrary.
// ======================================================
function neutralWeight(index) {
    if (!motion) return 1;
    const count = motion.frames.length;
    const rise = Math.min(1, index / BLEND_FRAMES);
    const fall = Math.min(1, (count - 1 - index) / BLEND_FRAMES);
    const w = Math.min(rise, fall);
    return w * w * (3 - 2 * w);
}

function blendToNeutral(weight) {
    if (weight >= 0.999) return;
    const t = 1 - weight;
    for (const d of drivenBones) d.bone.quaternion.slerp(d.rest, t);
}

function resetModel() {
    playing = false;
    currentFrame = -1;
    for (const d of drivenBones) d.bone.quaternion.copy(d.rest);
    for (const side in handRigs) {
        handRigs[side].smoothed.copy(handRigs[side].restQuaternion);
        handRigs[side].lastAccepted = -99;
    }
    if (model) model.updateMatrixWorld(true);
    if (motion && motion.frames.length) {
        applyFrame(motion.frames[0], 0, true);
        currentFrame = 0;
    }
    referenceVideo.pause();
    referenceVideo.currentTime = 0;
    setStatus("Reset — press Play sign");
}

// ======================================================
// LOADING
// ======================================================
async function loadMotion() {
    const response = await fetch("./motion.json");
    if (!response.ok) throw new Error(`motion.json: HTTP ${response.status}`);
    motion = await response.json();
    fps = motion.fps || 30;
    aspect = (motion.width && motion.height) ? motion.width / motion.height : 1;
    usingWorld = motion.frames.some(f => f.pose_world);
    prepareSegmentStatistics(motion.frames);
    console.log(`motion.json: ${motion.frames.length} frames @ ${fps}fps, ` +
        `${usingWorld ? "pose_world (metres)" : "pose (image space)"}, aspect ${aspect.toFixed(2)}`);
}

function loadModel() {
    return new Promise((resolve, reject) => {
        new GLTFLoader().load("./jakke.glb", gltf => {
            model = gltf.scene;
            scene.add(model);
            applyFacing();
            model.updateMatrixWorld(true);

            avatarHip = model.getObjectByName("CC_Base_Hip");
            avatarChest = model.getObjectByName("CC_Base_Spine02");
            if (!avatarHip || !avatarChest) console.warn("MISSING torso bones");

            captureArmRig("left");
            captureArmRig("right");
            captureHandRig("left");
            captureHandRig("right");
            finishArmRig("left");
            finishArmRig("right");

            for (const side of ["left", "right"]) {
                const rig = handRigs[side], arm = armRigs[side];
                console.log(`${side}: curlSign ${rig ? (rig.curlSign > 0 ? "+1" : "-1") : "?"}, ` +
                    `${rig ? Object.keys(rig.fingers).length : 0} fingers` +
                    `${rig && rig.thumb ? " + thumb" : ""}, ` +
                    `elbow axis ${arm && arm.restElbowAxis ? "derived" : "MISSING"}`);
            }
            console.log(`driven bones: ${drivenBones.length}`);

            buildDebugHelpers();
            resolve();
        }, undefined, reject);
    });
}

// ======================================================
// FACING
// ======================================================
const faceAwayInput = document.getElementById("faceAway");

function applyFacing() {
    if (model) model.rotation.y = faceAwayInput.checked ? Math.PI : 0;
}

function refreshCurrentFrame() {
    if (!model || !motion) return;
    const index = currentFrame >= 0 ? currentFrame : 0;
    for (let pass = 0; pass < 3; pass++) applyFrame(motion.frames[index], index, true);
}

faceAwayInput.addEventListener("change", () => {
    applyFacing();
    if (model) model.updateMatrixWorld(true);
    refreshCurrentFrame();
});
mirrorXInput.addEventListener("change", refreshCurrentFrame);
flipZInput.addEventListener("change", refreshCurrentFrame);

// ======================================================
// DEBUG VISUALISATION
//
// The point is to see SOURCE -> TARGET divergence directly. The signer's
// own skeleton is drawn superimposed on Jake: mapped through the same
// body transform the retargeting uses, anchored at Jake's chest and
// scaled by the ratio of shoulder widths. Where the green source markers
// and Jake's joints disagree, that is the retargeting error, visible.
//
//   green   source pose landmarks (shoulder / elbow / wrist)
//   yellow  source hand landmarks, all 21
//   red     palm curl axis (across the knuckles)
//   green   palm forward (towards the fingertips)
//   blue    palm normal (out of the palm)
//   white   avatar bone directions
// ======================================================
const debugToggle = document.getElementById("debugToggle");
let debugOn = false;

let sourceGroup = null;
let sourcePoints = null;
let sourceLines = null;
let handPoints = { left: null, right: null };
const debugArrows = {};
const debugLabels = {};

const POSE_LINKS = [[0, 1], [1, 2]];   // shoulder-elbow-wrist per side
const HAND_LINKS = [
    [0, 1], [1, 2], [2, 3], [3, 4],
    [0, 5], [5, 6], [6, 7], [7, 8],
    [0, 9], [9, 10], [10, 11], [11, 12],
    [0, 13], [13, 14], [14, 15], [15, 16],
    [0, 17], [17, 18], [18, 19], [19, 20],
    [5, 9], [9, 13], [13, 17]
];

function makePoints(count, color, size) {
    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute("position",
        new THREE.BufferAttribute(new Float32Array(count * 3), 3));
    const points = new THREE.Points(geometry,
        new THREE.PointsMaterial({ color, size, sizeAttenuation: true,
            depthTest: false, transparent: true }));
    points.renderOrder = 999;
    points.visible = false;
    return points;
}

function makeLines(count, color) {
    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute("position",
        new THREE.BufferAttribute(new Float32Array(count * 6), 3));
    const lines = new THREE.LineSegments(geometry,
        new THREE.LineBasicMaterial({ color, depthTest: false, transparent: true,
            opacity: 0.8 }));
    lines.renderOrder = 998;
    lines.visible = false;
    return lines;
}

function makeLabel(text, color) {
    const canvas = document.createElement("canvas");
    canvas.width = 128; canvas.height = 64;
    const ctx = canvas.getContext("2d");
    ctx.fillStyle = color;
    ctx.font = "bold 44px ui-monospace, monospace";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(text, 64, 32);
    const sprite = new THREE.Sprite(new THREE.SpriteMaterial({
        map: new THREE.CanvasTexture(canvas), depthTest: false, transparent: true }));
    sprite.scale.set(0.09, 0.045, 1);
    sprite.renderOrder = 1000;
    sprite.visible = false;
    scene.add(sprite);
    return sprite;
}

function arrow(color) {
    const a = new THREE.ArrowHelper(new THREE.Vector3(0, 1, 0), new THREE.Vector3(),
        0.09, color, 0.03, 0.02);
    a.visible = false;
    a.renderOrder = 997;
    scene.add(a);
    return a;
}

function buildDebugHelpers() {
    sourceGroup = new THREE.Group();
    scene.add(sourceGroup);

    sourcePoints = makePoints(6, 0x66ff88, 0.022);
    sourceLines = makeLines(4, 0x66ff88);
    sourceGroup.add(sourcePoints, sourceLines);

    for (const side of ["left", "right"]) {
        handPoints[side] = {
            points: makePoints(21, 0xffdd44, 0.010),
            lines: makeLines(HAND_LINKS.length, 0xffdd44)
        };
        sourceGroup.add(handPoints[side].points, handPoints[side].lines);

        debugArrows[side] = {
            curl: arrow(0xff5566), forward: arrow(0x66ff88), normal: arrow(0x6699ff),
            upper: arrow(0xffffff), fore: arrow(0xffffff)
        };
        debugLabels[side] = makeLabel(side === "left" ? "L" : "R",
            side === "left" ? "#ff8888" : "#88bbff");
    }
}

const _tmp = new THREE.Vector3();
const _boneA = new THREE.Vector3();
const _boneB = new THREE.Vector3();

function writePositions(target, list) {
    const array = target.geometry.attributes.position.array;
    for (let i = 0; i < list.length; i++) {
        array[i * 3] = list[i].x; array[i * 3 + 1] = list[i].y; array[i * 3 + 2] = list[i].z;
    }
    target.geometry.attributes.position.needsUpdate = true;
    target.geometry.setDrawRange(0, list.length);
}

function writeLinks(target, list, links) {
    const array = target.geometry.attributes.position.array;
    let n = 0;
    for (const [a, b] of links) {
        if (!list[a] || !list[b]) continue;
        array[n++] = list[a].x; array[n++] = list[a].y; array[n++] = list[a].z;
        array[n++] = list[b].x; array[n++] = list[b].y; array[n++] = list[b].z;
    }
    target.geometry.attributes.position.needsUpdate = true;
    target.geometry.setDrawRange(0, n / 3);
}

function degrees(radians) {
    return (radians * 180 / Math.PI).toFixed(0).padStart(4);
}

function updateDebug() {
    const lines = [
        `frame     ${debugState.frame + 1} / ${motion ? motion.frames.length : "?"}`,
        `body fix  ${debugState.bodyAngle.toFixed(1)} deg  (source body -> Jake body)`,
        `neutral   ${(neutralWeight(debugState.frame) * 100).toFixed(0)}%`
    ];

    // ---- source skeleton, walked along JAKE's bone lengths ----------
    // Comparing raw source joint POSITIONS would be meaningless: the
    // retargeting matches directions, and Jake's arm is not the signer's
    // length, so the two would diverge even when the retargeting is
    // perfect. Instead the source DIRECTIONS are walked out along Jake's
    // own segment lengths from his own shoulder, in applyFrame. Green
    // sitting on the avatar's joint means correct; a gap is real error.
    const sourcePts = [];
    for (const side of ["left", "right"]) {
        const a = debugState.arms[side];
        if (!a || !a.srcShoulder) continue;
        sourcePts.push(a.srcShoulder, a.srcElbow, a.srcWrist);
    }
    writePositions(sourcePoints, sourcePts);
    writeLinks(sourceLines, sourcePts, [[0, 1], [1, 2], [3, 4], [4, 5]]);

    for (const side of ["left", "right"]) {
        const rig = handRigs[side];
        const state = debugState.hands[side];
        const arrows = debugArrows[side];
        const label = debugLabels[side];
        const hp = handPoints[side];

        lines.push("");
        lines.push(`${side.toUpperCase()} HAND` +
            (!state ? "   (no landmarks)"
                : state.rejected ? `   (${state.rejected} — held)` : ""));

        const arm = debugState.arms[side];
        if (arm) {
            lines.push(`  elbow bend ${arm.bend.toFixed(0)} deg` +
                (arm.elbowError !== undefined
                    ? `   src->bone err  elbow ${(arm.elbowError * 1000).toFixed(1)}mm` +
                      `  wrist ${(arm.wristError * 1000).toFixed(1)}mm`
                    : ""));
        }

        if (rig) {
            const at = rig.hand.getWorldPosition(new THREE.Vector3());
            label.position.copy(at).add(new THREE.Vector3(0, 0.07, 0));
            label.visible = true;

            const armRig = armRigs[side];
            if (armRig) {
                armRig.upper.bone.getWorldPosition(_boneA);
                armRig.fore.bone.getWorldPosition(_boneB);
                arrows.upper.position.copy(_boneA);
                arrows.upper.setDirection(_tmp.subVectors(_boneB, _boneA).normalize());
                arrows.upper.setLength(_boneA.distanceTo(_boneB), 0.02, 0.014);
                arrows.upper.visible = true;

                arrows.fore.position.copy(_boneB);
                arrows.fore.setDirection(_tmp.subVectors(at, _boneB).normalize());
                arrows.fore.setLength(_boneB.distanceTo(at), 0.02, 0.014);
                arrows.fore.visible = true;
            }
        }

        if (!state || !state.landmarks) {
            for (const k of ["curl", "forward", "normal"]) arrows[k].visible = false;
            hp.points.visible = false; hp.lines.visible = false;
            continue;
        }

        const q = state.quaternion;
        if (q) lines.push(`  wrist quat ${q.x.toFixed(3)} ${q.y.toFixed(3)} ` +
                          `${q.z.toFixed(3)} ${q.w.toFixed(3)}`);
        lines.push("           MCP  PIP  DIP  spr   conf");
        for (const finger of FINGERS) {
            const v = state.fingers[finger];
            if (!v) continue;
            lines.push(`  ${finger.padEnd(6)} ${degrees(v[0])} ${degrees(v[1])} ` +
                `${degrees(v[2])} ${degrees(v[3])}   ${v[4].toFixed(2)}/${v[5].toFixed(2)}/${v[6].toFixed(2)}`);
        }
        if (state.fingers.thumb) {
            lines.push(`  thumb  ${degrees(state.fingers.thumb[0])} ` +
                `${degrees(state.fingers.thumb[1])}        ${state.fingers.thumb[2].toFixed(2)}`);
        }

        // source hand landmarks, anchored on Jake's wrist at his scale
        if (rig) {
            const anchor = rig.hand.getWorldPosition(new THREE.Vector3());
            const span = state.landmarks[HAND.INDEX_MCP]
                .distanceTo(state.landmarks[HAND.PINKY_MCP]);
            const hs = span > 1e-6 ? rig.knuckleSpan / span : 1;
            const pts = state.landmarks.map(v =>
                v.clone().sub(state.landmarks[0]).multiplyScalar(hs).add(anchor));
            writePositions(hp.points, pts);
            writeLinks(hp.lines, pts, HAND_LINKS);
            hp.points.visible = true; hp.lines.visible = true;

            for (const [key, axis] of [["curl", state.basis.curl],
                                       ["forward", state.basis.forward],
                                       ["normal", state.basis.normal]]) {
                arrows[key].position.copy(anchor);
                arrows[key].setDirection(axis);
                arrows[key].visible = true;
            }
        }
    }

    sourcePoints.visible = true;
    sourceLines.visible = true;
    debugElement.textContent = lines.join("\n");
}

function setDebug(on) {
    debugOn = on;
    debugToggle.checked = on;
    debugElement.hidden = !on;
    if (!on) {
        for (const side in debugArrows)
            for (const k in debugArrows[side]) debugArrows[side][k].visible = false;
        for (const side in debugLabels) debugLabels[side].visible = false;
        for (const side in handPoints) {
            if (!handPoints[side]) continue;
            handPoints[side].points.visible = false;
            handPoints[side].lines.visible = false;
        }
        if (sourcePoints) sourcePoints.visible = false;
        if (sourceLines) sourceLines.visible = false;
    } else if (motion) {
        updateDebug();
    }
}

debugToggle.addEventListener("change", () => setDebug(debugToggle.checked));
window.addEventListener("keydown", e => {
    if (e.key === "d" || e.key === "D") setDebug(!debugOn);
});

function setStatus(text) { statusElement.textContent = text; }

// ======================================================
// CONTROLS
// ======================================================
const loopInput = document.getElementById("loopToggle");

document.getElementById("playButton").addEventListener("click", () => {
    if (!motion || !model) return;
    playing = true;
    currentFrame = -1;
    startTime = performance.now();
    referenceVideo.currentTime = 0;
    referenceVideo.play().catch(() => {});
});

document.getElementById("resetButton").addEventListener("click", resetModel);

function animate() {
    requestAnimationFrame(animate);
    controls.update();

    if (playing && motion) {
        const elapsed = (performance.now() - startTime) / 1000;
        let index = Math.floor(elapsed * fps);

        if (index >= motion.frames.length) {
            if (loopInput.checked) {
                startTime = performance.now();
                index = 0;
                referenceVideo.currentTime = 0;
                referenceVideo.play().catch(() => {});
            } else {
                playing = false;
                index = motion.frames.length - 1;
                setStatus("Finished — at neutral");
            }
        }

        const frame = motion.frames[index];
        applyFrame(frame, index, false);
        currentFrame = index;

        if (playing) {
            const hands = (frame.left_hand ? "L" : "·") + (frame.right_hand ? "R" : "·");
            setStatus(`${usingWorld ? "pose_world" : "pose"}  hands ${hands}\n` +
                `frame ${index + 1} / ${motion.frames.length}`);
        }
    }

    renderer.render(scene, camera);
}

// ======================================================
// CONSOLE HOOK
//
//   jake.seek(29)                 pose one frame, smoothing bypassed
//   jake.focus("right")           camera onto that hand
//   jake.calibration.right.FINGER_CURL_SCALE = 1.3
//   jake.debug(true)
// ======================================================
window.jake = {
    calibration: CALIBRATION,
    limits: LIMITS,
    trim: FINGER_TRIM,
    get rigs() { return handRigs; },
    get arms() { return armRigs; },
    get state() { return debugState; },
    get frame() { return currentFrame; },
    get frameCount() { return motion ? motion.frames.length : 0; },

    seek(index) {
        if (!motion || !model) return null;
        const i = Math.max(0, Math.min(motion.frames.length - 1, index | 0));
        playing = false;
        // The palm is solved before the fingers, so one pass leaves the
        // finger axes reading a stale hand.
        for (let pass = 0; pass < 4; pass++) applyFrame(motion.frames[i], i, true);
        currentFrame = i;
        referenceVideo.currentTime = i / fps;
        setStatus(`frame ${i + 1} / ${motion.frames.length}`);
        if (debugOn) updateDebug();
        return i;
    },

    focus(side, distance = 0.42) {
        if (!side) {
            camera.position.set(0, 1.42, 2.05);
            controls.target.set(0, 1.30, 0);
            controls.update();
            return;
        }
        const rig = handRigs[side];
        if (!rig) return;
        const at = rig.hand.getWorldPosition(new THREE.Vector3());
        const outward = side === "left" ? 1 : -1;
        controls.target.copy(at);
        camera.position.set(at.x + outward * distance * 0.45,
            at.y + distance * 0.30, at.z + distance);
        controls.update();
    },

    debug(on) { setDebug(on !== false); }
};

async function start() {
    // Render from the first tick: jakke.glb is tens of megabytes and a
    // black window for the length of that download reads as a broken page.
    animate();
    try {
        setStatus("Loading Jake…");
        await loadModel();
        setStatus("Loading motion…");
        await loadMotion();
        applyFrame(motion.frames[0], 0, true);
        currentFrame = 0;
        setStatus("Ready — press Play sign");
    } catch (error) {
        console.error(error);
        setStatus("ERROR — see browser console");
    }
}

start();

window.addEventListener("resize", () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});

</script>
</body>
</html>
