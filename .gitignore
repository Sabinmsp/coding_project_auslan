# ---------------------------------------------------------------------
# What is NOT in Git, and where it comes from instead
# ---------------------------------------------------------------------

# Regenerable sign library media (~700 MB) -- rebuilt by
#   ../.venv-1/bin/python scripts/build_library.py
# (the manifest, keywords, catalog and extraction log ARE tracked)
assets/signs/motion/
assets/signs/videos/

# Fingerspelling media (~160 MB). NOT reproducible by a script yet, so it is
# backed up outside the repository and verified:
#   ~/auslan-backups/fingerspelling_2026-10-24.tar.gz
# restore from the project root:  tar -xzf ~/auslan-backups/fingerspelling_2026-10-24.tar.gz
# (assets/fingerspelling/letters.json IS tracked)
assets/fingerspelling/motion/
assets/fingerspelling/videos/
assets/fingerspelling/phrases/
datasets/processed/fingerspell_letters/

# Build output, logs, QA images -- all regenerated
dist/
datasets/processed/logs/
datasets/processed/qa/
datasets/processed/final_status.txt
*.tmp

# Large datasets are symlinks into the original workspace: the LINKS are
# tracked, never their contents
datasets/videos/rgb/

# Experiments: code and notes are tracked; their media and model files are
# not (they remain in the original workspace and the cleanup backup)
experiments/**/*.mp4
experiments/**/*.mov
experiments/**/*.gif
experiments/**/*.glb
experiments/**/*.fbx
experiments/**/*.blend
experiments/**/*.blend1
experiments/**/*.npz
experiments/**/*.npy
experiments/**/*.pt
experiments/2d/legacy_sign_files/

# Python / OS / editor
__pycache__/
*.pyc
.venv/
.DS_Store
.env
.env.*
